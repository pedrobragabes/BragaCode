# URL pública completa, sem barra no final.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Contato: escolha Resend ou webhook.
RESEND_API_KEY=
CONTACT_TO_EMAIL=pedrobraga855@gmail.com
CONTACT_FROM_EMAIL=BragaCode <contato@seudominio.com.br>
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Proteção opcional do formulário. Configure as duas chaves juntas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics opcional. Plausible é o padrão recomendado; copie a URL única do
# script exibida em Site Settings > Site Installation.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
NEXT_PUBLIC_GA_ID=

# Monitoramento opcional de erros no Cloudflare Worker (Sentry).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
